# Copy to .env.local and fill in values from your Supabase project + Anthropic console.

# --- Supabase (frontend, safe to expose) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (scraper only — NEVER commit, NEVER add to Vercel) ---
# Bypasses Row Level Security. Used by scraper/run.ts to write rows.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic ---
# Used by: scraper (agenda extraction) + Next.js /api/search route (NL query parsing).
# Add to Vercel environment variables (server-only — no NEXT_PUBLIC_ prefix needed).
ANTHROPIC_API_KEY=
