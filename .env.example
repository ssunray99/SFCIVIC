# Copy to .env.local and fill in values from your Supabase project + Google AI Studio.

# --- Supabase (frontend, safe to expose) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (scraper only — NEVER commit, NEVER add to Vercel) ---
# Bypasses Row Level Security. Used by scraper/run.ts to write rows.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Google Gemini ---
# Used by: scraper (agenda extraction via gemini-2.5-flash) + Next.js
# /api/search route (NL query parsing). Get a key at https://aistudio.google.com/apikey
# Add to Vercel environment variables (server-only — no NEXT_PUBLIC_ prefix needed).
GEMINI_API_KEY=
