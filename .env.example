# Copy to .env.local and fill in values from your Supabase project + Anthropic console.

# --- Supabase (frontend, safe to expose) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (scraper only — NEVER commit, NEVER add to Vercel) ---
# Bypasses Row Level Security. Used by scraper/run.ts to write rows.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic (scraper only) ---
# Claude Haiku 4.5 for agenda item extraction + summarization.
ANTHROPIC_API_KEY=
