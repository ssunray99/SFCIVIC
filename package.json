    "scrape:bos-land-use": "tsx --env-file=.env.local scraper/run.ts bos-land-use",
    "scrape:bos-budget": "tsx --env-file=.env.local scraper/run.ts bos-budget",
    "scrape:bos-rules": "tsx --env-file=.env.local scraper/run.ts bos-rules",
    "scrape:bos-public-safety": "tsx --env-file=.env.local scraper/run.ts bos-public-safety",
    "scrape:bos-gao": "tsx --env-file=.env.local scraper/run.ts bos-gao",
    "scrape:sfmta": "tsx --env-file=.env.local scraper/run.ts sfmta",
    "extract": "tsx --env-file=.env.local scraper/run.ts extract",
