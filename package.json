{
  "name": "sfcivic",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "scrape": "tsx --env-file=.env.local scraper/run.ts",
    "scrape:planning": "tsx --env-file=.env.local scraper/run.ts planning",
    "scrape:bos": "tsx --env-file=.env.local scraper/run.ts bos",
