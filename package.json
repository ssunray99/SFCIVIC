    "backfill:planning": "tsx --env-file=.env.local scraper/setup/backfill-planning.ts",
    "backfill:bos-committees": "tsx scraper/setup/backfill-bos-committees.ts",
    "backfill:bos-minutes": "tsx --env-file=.env.local scraper/setup/backfill-bos-minutes.ts",
    "backfill:prompt-version": "tsx --env-file=.env.local scraper/setup/backfill-prompt-version.ts",
    "fetch:geo": "tsx scraper/setup/fetch-geo.ts",
    "smoke:legistar": "tsx scraper/setup/legistar-smoke.ts",
    "smoke:datasf": "tsx scraper/setup/datasf-legislation-smoke.ts",
    "db:types": "supabase gen types typescript --linked > src/lib/database.types.ts",
    "db:push": "supabase db push",
    "supabase": "supabase"
