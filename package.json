    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "p-retry": "^8.0.0",
    "pdf-parse": "1.1.1",
    "playwright": "^1.59.1",
    "supabase": "^2.98.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
